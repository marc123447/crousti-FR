@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root{--ink:#20112f;--paper:#fff9f2;--pink:#ff6b91;--yellow:#ffd84d;--blue:#72cce8;--orange:#ff8a55;--muted:#765f73;--line:rgba(32,17,47,.16);--radius:24px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:'Space Grotesk',Arial,sans-serif;overflow-x:hidden}.noise{position:fixed;inset:0;pointer-events:none;opacity:.055;z-index:20;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E")}.age-gate{position:fixed;inset:0;background:rgba(32,17,47,.88);display:grid;place-items:center;padding:20px;z-index:100;backdrop-filter:blur(10px)}.age-gate.hidden{display:none}.age-card{max-width:500px;background:var(--paper);padding:44px;border:2px solid var(--ink);box-shadow:10px 10px 0 var(--pink);text-align:center}.age-card h2{font-size:clamp(2rem,5vw,3.3rem);line-height:.95;margin:14px 0}.age-card p{font-size:1.05rem;line-height:1.6;color:var(--muted)}.age-card small{display:block;margin-top:22px;color:var(--muted);line-height:1.45}.age-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}.site-header{height:82px;padding:0 5vw;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);position:relative;z-index:10}.brand{display:inline-flex;align-items:center;gap:10px;color:var(--ink);text-decoration:none;font-weight:600;font-size:1.1rem;letter-spacing:-.04em}.brand b{color:var(--pink)}.brand-mark{display:grid;place-items:center;width:27px;height:27px;color:var(--ink);background:var(--yellow);border-radius:50%;font-size:.9rem}.nav{display:flex;align-items:center;gap:26px}.nav a,.footer-links a{font-size:.78rem;color:var(--muted);text-decoration:none}.nav a:hover,.footer-links a:hover,.text-link:hover{color:var(--pink)}.nav-cta{padding:12px 16px;border:1px solid var(--ink);color:var(--ink)!important;border-radius:99px}.nav-cta span,.btn span{margin-left:8px}.menu-toggle{display:none;border:0;background:transparent;font-size:1.5rem;color:var(--ink)}.section-grid{display:grid;grid-template-columns:1.02fr .98fr;min-height:680px;padding:72px 8vw 68px;gap:4vw;align-items:center}.hero-copy{max-width:670px}.eyebrow,.section-kicker{font:500 .7rem 'DM Mono',monospace;letter-spacing:.14em;text-transform:uppercase}.eyebrow{color:var(--pink)}h1,h2,h3,p{margin-top:0}h1{font-size:clamp(4rem,8.8vw,8.2rem);letter-spacing:-.09em;line-height:.82;margin:26px 0 36px;font-weight:700}h1 span{color:var(--pink);position:relative}h1 span:after{content:'';position:absolute;height:12px;left:0;right:7%;bottom:-13px;background:var(--yellow);z-index:-1;transform:rotate(-2deg)}.hero-lead{font-size:1.18rem;line-height:1.55;max-width:580px;color:var(--muted)}.hero-lead strong{color:var(--ink)}.hero-actions{display:flex;align-items:center;gap:26px;margin-top:32px}.btn{display:inline-flex;align-items:center;justify-content:center;border:1.5px solid var(--ink);border-radius:999px;padding:15px 21px;font:600 .86rem 'Space Grotesk',sans-serif;text-decoration:none;cursor:pointer;transition:.2s transform,.2s box-shadow}.btn:hover{transform:translate(-3px,-3px);box-shadow:4px 4px 0 var(--ink)}.btn-primary{background:var(--pink);color:var(--ink)}.btn-ghost{background:transparent;color:var(--ink)}.btn-light{background:var(--paper);color:var(--ink);border-color:var(--paper)}.text-link{font-size:.85rem;text-decoration:none;color:var(--ink);border-bottom:1px solid var(--ink);padding-bottom:4px}.hero-meta{display:flex;flex-wrap:wrap;gap:17px;margin-top:54px;color:var(--muted);font:500 .68rem 'DM Mono',monospace;text-transform:uppercase}.hero-meta span{display:flex;align-items:center;gap:7px}.dot{width:7px;height:7px;display:inline-block;border-radius:50%}.dot-pink{background:var(--pink)}.dot-yellow{background:var(--yellow)}.dot-blue{background:var(--blue)}.hero-art{min-height:570px;position:relative;display:grid;place-items:center}.hero-photo-frame{width:min(430px,78%);aspect-ratio:.76;position:relative;overflow:hidden;border:2px solid var(--ink);border-radius:220px 220px 30px 30px;transform:rotate(4deg);background:var(--pink);box-shadow:10px 10px 0 var(--ink);z-index:1}.hero-photo{width:100%;height:100%;display:block;object-fit:cover;object-position:center 33%;filter:saturate(1.03) contrast(1.02)}.hero-photo-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(32,17,47,0) 55%,rgba(32,17,47,.65) 100%)}.hero-photo-label{position:absolute;right:25px;bottom:26px;color:var(--paper);font:500 .65rem 'DM Mono',monospace;line-height:1.2;letter-spacing:.08em;text-align:right}.hero-photo-label strong{font-size:1.12rem;color:var(--yellow)}.art-card{position:absolute;width:min(380px,75%);aspect-ratio: .76;background:var(--yellow);border:2px solid var(--ink);border-radius:210px 210px 28px 28px;transform:rotate(8deg)}.art-card-back{background:var(--blue);transform:rotate(-9deg) translate(-25px,7px)}.art-card-main{background:var(--pink);display:flex;align-items:center;justify-content:center;overflow:hidden;box-shadow:9px 9px 0 var(--ink)}.art-card-main:before{content:'';position:absolute;width:250px;height:250px;border-radius:50%;background:var(--orange);right:-90px;top:-65px}.art-label,.art-foot{position:absolute;font:500 .65rem 'DM Mono',monospace;line-height:1.2;letter-spacing:.08em}.art-label{top:28px;left:27px}.art-label strong{font-size:1.12rem}.art-foot{bottom:28px;right:27px;text-align:right}.art-foot span{color:var(--paper)}.heel{width:55%;height:63%;color:var(--paper);transform:rotate(-12deg);position:relative;z-index:1}.sticker{position:absolute;background:var(--yellow);border:2px solid var(--ink);padding:13px 17px;font:500 .75rem 'DM Mono',monospace;line-height:1.05;z-index:3;box-shadow:4px 4px 0 var(--ink)}.sticker b{font-size:1.2rem}.sticker-top{top:60px;right:3%;transform:rotate(9deg)}.sticker-bottom{bottom:65px;left:2%;transform:rotate(-11deg);background:var(--blue)}.burst{position:absolute;border-radius:50%;filter:blur(.2px)}.burst-1{width:88px;height:88px;background:var(--orange);top:12%;left:3%}.burst-2{width:45px;height:45px;background:var(--pink);bottom:7%;right:10%}.sparkle{position:absolute;font-size:2.2rem}.sparkle-1{top:17%;right:12%}.sparkle-2{bottom:16%;left:13%;color:var(--pink)}.ticker{display:flex;justify-content:space-around;align-items:center;gap:15px;background:var(--ink);color:var(--paper);padding:17px 5vw;font:500 .7rem 'DM Mono',monospace;letter-spacing:.16em;white-space:nowrap;overflow:hidden}.ticker span{color:var(--pink);font-size:1.1rem}.content-section{max-width:1220px;margin:auto;padding:118px 6vw}.section-kicker{color:var(--pink);margin-bottom:34px}.intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:10vw}.intro h2,.process h2,.faq-section h2{font-size:clamp(3.6rem,7vw,7.2rem);letter-spacing:-.09em;line-height:.84;margin:0}.intro h2 em,.process h2 em,.faq-section h2 em{color:var(--pink);font-style:normal}.intro-text{max-width:540px;padding-top:8px}.large-copy{font-size:1.5rem;line-height:1.35;letter-spacing:-.04em}.intro-text p:not(.large-copy){color:var(--muted);line-height:1.65}.intro blockquote{margin:30px 0 0;padding:19px 22px;border-left:5px solid var(--yellow);font-size:1.25rem;font-weight:600;line-height:1.3}.value-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:80px}.value-card{padding:28px;min-height:220px;border:1.5px solid var(--ink);position:relative}.value-card.pink{background:var(--pink)}.value-card.yellow{background:var(--yellow)}.value-card.blue{background:var(--blue)}.card-number,.step-index{font:500 .68rem 'DM Mono',monospace}.value-card h3{font-size:1.75rem;letter-spacing:-.05em;margin:46px 0 12px}.value-card p{font-size:.9rem;line-height:1.45;max-width:260px}.casting-section,.application-section{background:var(--ink);color:var(--paper);position:relative;overflow:hidden}.casting-inner{position:relative;z-index:1}.section-kicker.light{color:var(--yellow)}.casting-heading{display:flex;justify-content:space-between;align-items:end;gap:8vw}.casting-heading h2,.application-copy h2{font-size:clamp(3.3rem,6.5vw,6.5rem);letter-spacing:-.09em;line-height:.84;margin:0}.casting-heading h2 span,.application-copy h2 span{color:var(--yellow)}.casting-heading p{max-width:400px;color:#c6b9c7;line-height:1.6}.casting-points{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;border-top:1px solid rgba(255,249,242,.24);margin-top:72px;padding-top:34px;margin-bottom:48px}.point{display:flex;gap:16px}.point>span{color:var(--pink);font-size:1.4rem}.point h3{font-size:1.1rem;margin-bottom:10px}.point p{color:#c6b9c7;font-size:.87rem;line-height:1.5}.scribble{position:absolute;right:-20px;bottom:-55px;color:#2f1b41;font:bold 15rem/.72 'Space Grotesk';letter-spacing:-.15em;transform:rotate(-9deg)}.process-heading{display:flex;justify-content:space-between;align-items:end;gap:8vw}.process-heading p{max-width:390px;color:var(--muted);line-height:1.6}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:70px}.step{border-top:2px solid var(--ink);padding-top:18px}.step-index{color:var(--pink)}.step-icon{width:66px;height:66px;display:grid;place-items:center;border-radius:50%;margin:44px 0 24px;background:var(--yellow);border:1.5px solid var(--ink);font-size:1.7rem}.step:nth-child(2) .step-icon{background:var(--blue)}.step:nth-child(3) .step-icon{background:var(--pink)}.step h3{font-size:1.5rem;letter-spacing:-.05em;margin-bottom:10px}.step p{color:var(--muted);line-height:1.55;max-width:290px}.quote-section{min-height:430px;background:var(--yellow);display:grid;place-items:center;text-align:center;position:relative;overflow:hidden;padding:70px 5vw}.quote-mark{font:9rem/.5 Georgia,serif;margin:0;color:var(--pink);position:relative;z-index:1}.quote-section blockquote{font-size:clamp(2.5rem,5vw,5.8rem);font-weight:700;letter-spacing:-.09em;line-height:.86;margin:0;position:relative;z-index:1}.quote-section blockquote span{color:var(--pink)}.quote-caption{font:500 .68rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.1em;margin:24px 0 0;position:relative;z-index:1}.quote-shape{position:absolute;border:2px solid var(--ink);border-radius:50%}.shape-left{width:330px;height:330px;left:-140px;top:45px;background:var(--blue)}.shape-right{width:240px;height:240px;right:-75px;bottom:-70px;background:var(--pink)}.faq-layout{display:grid;grid-template-columns:1fr 1.35fr;gap:10vw}.faq-list{border-top:1.5px solid var(--ink)}details{border-bottom:1.5px solid var(--ink);padding:23px 0}summary{cursor:pointer;list-style:none;font-weight:600;font-size:1rem;display:flex;justify-content:space-between;gap:20px}summary::-webkit-details-marker{display:none}summary span{font-size:1.4rem;font-weight:400;transition:.2s}details[open] summary span{transform:rotate(45deg)}details p{color:var(--muted);line-height:1.6;max-width:650px;padding:14px 40px 0 0;margin-bottom:0}.application-inner{max-width:1220px;margin:auto;padding:118px 6vw;display:grid;grid-template-columns:.85fr 1.15fr;gap:10vw}.application-copy h2{margin:20px 0 28px}.application-copy>p{color:#c6b9c7;line-height:1.6;max-width:400px}.application-note{display:flex;align-items:center;gap:15px;margin-top:44px;border-top:1px solid rgba(255,249,242,.25);padding-top:18px}.application-note span{display:grid;place-items:center;width:43px;height:43px;border-radius:50%;background:var(--pink);color:var(--ink);font-weight:700}.application-note p{font-size:.76rem;line-height:1.4;color:#c6b9c7;margin:0;max-width:280px}.application-form{background:var(--paper);color:var(--ink);padding:34px;border:2px solid var(--yellow);box-shadow:10px 10px 0 var(--pink)}label{display:block;font-size:.75rem;font-weight:600;margin-bottom:19px}input,textarea{display:block;width:100%;font:400 .9rem 'Space Grotesk',sans-serif;color:var(--ink);background:transparent;border:0;border-bottom:1.5px solid var(--line);border-radius:0;padding:11px 0 10px;outline:none}input:focus,textarea:focus{border-color:var(--pink)}textarea{resize:vertical;min-height:100px}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:20px}.checkbox{display:flex;align-items:flex-start;gap:10px;color:var(--muted);font-weight:400;line-height:1.4}.checkbox input{width:17px;height:17px;accent-color:var(--pink);margin:0;flex:none}.btn-submit{border:1.5px solid var(--ink);width:100%;margin-top:4px}.form-status{font-size:.8rem;margin:15px 0 0;color:var(--muted)}.site-footer{display:grid;grid-template-columns:1fr 1fr 1fr;align-items:center;gap:20px;padding:34px 6vw;border-top:1px solid var(--line)}.site-footer>p{font-size:.82rem;color:var(--muted);text-align:center;margin:0}.footer-links{display:flex;justify-content:flex-end;gap:19px}.site-footer small{grid-column:1/-1;color:var(--muted);font:400 .65rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.08em}.reveal{animation:up .7s both}@keyframes up{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}.delay-1{animation-delay:.1s}.delay-2{animation-delay:.2s}.delay-3{animation-delay:.3s}.delay-4{animation-delay:.4s}
@media(max-width:850px){.site-header{height:72px}.nav{display:none;position:absolute;top:72px;left:0;right:0;background:var(--paper);padding:20px 5vw;border-bottom:1px solid var(--line);flex-direction:column;align-items:flex-start}.nav.open{display:flex}.menu-toggle{display:block}.section-grid{grid-template-columns:1fr;min-height:auto;padding-top:60px}.hero-art{min-height:520px;margin-top:20px}.intro-grid,.faq-layout,.application-inner{grid-template-columns:1fr;gap:44px}.value-cards,.casting-points,.steps{grid-template-columns:1fr}.value-card{min-height:190px}.casting-heading,.process-heading{display:block}.casting-heading p,.process-heading p{margin-top:28px}.casting-points{gap:22px;margin-top:55px}.scribble{font-size:9rem}.site-footer{grid-template-columns:1fr;justify-items:start}.site-footer>p{text-align:left}.footer-links{justify-content:flex-start;flex-wrap:wrap}.site-footer small{grid-column:auto}.application-inner{padding-top:85px;padding-bottom:85px}.application-form{padding:25px;box-shadow:7px 7px 0 var(--pink)}h1{font-size:clamp(4rem,17vw,7rem)}}
@media(max-width:500px){.hero-photo-frame{width:82%}.hero-actions{align-items:flex-start;flex-direction:column;gap:20px}.hero-meta{gap:11px;line-height:1.4}.art-card{width:80%}.sticker-top{right:0}.sticker-bottom{left:-4px}.age-card{padding:30px 24px}.quote-section blockquote{font-size:2.8rem}.form-row{grid-template-columns:1fr;gap:0}}
